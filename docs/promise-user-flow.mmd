flowchart LR
    App[ PROMISE web app ]
    User([User])

    Auth[Authentication]
    Profile[Health profile]
    Logs[Period, symptom, and lifestyle data]
    Skin[Skin photo upload]
    Vision[Vision AI]
    Observations[Dermatology observations]
    Answers[PCOS screening answers]
    Rules[Rule-based risk engine]
    Risk{Elevated risk?}
    Score[Risk score and confidence]

    DB[(Supabase database)]
    Context[Combined health context]
    Assistant[AI health assistant]
    Insights[Personalized insights]
    Referral[Doctor referral recommendation]
    Report[Doctor report generator]
    Download[Downloadable doctor report]
    Automation[Make.com automation]
    Notice[Email, SMS, or push notifications]

    App --> Auth --> DB
    App --> Profile --> DB
    App --> Logs --> DB
    App --> Skin --> Vision --> Observations --> DB
    App --> Answers --> Rules --> Risk
    Risk -- Yes --> Referral
    Risk --> Score --> DB

    DB --> Context --> Assistant
    DB --> Insights
    DB --> Report --> Download --> User
    DB --> Automation --> Notice --> User
    DB --> Context
    App --> User
    Referral --> User
    Assistant --> Insights --> User

